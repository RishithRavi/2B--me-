# syntax=docker/dockerfile:1.7
# twobme-base: python:3.12-slim + ffmpeg + libsndfile1 + every server/voice dependency (CPU torch).
# Built ONCE on the VM and rebuilt only when uv.lock changes (infra/deploy.sh tags it by the lock hash).
#   docker build -f infra/Dockerfile.base -t twobme-base:latest .

# --- manifests only (so source edits never invalidate the dependency layer) -----------------------
FROM python:3.12-slim AS manifests
WORKDIR /src
COPY . .
RUN mkdir -p /out && cp pyproject.toml uv.lock .python-version /out/ \
 && for f in $(find packages server agent -maxdepth 2 -name pyproject.toml 2>/dev/null); do \
      mkdir -p "/out/$(dirname "$f")" && cp "$f" "/out/$f"; \
    done

# --- base -------------------------------------------------------------------------------------------
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1 UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv PATH=/opt/venv/bin:$PATH \
    HF_HOME=/models/hf
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg libsndfile1 ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /uvx /bin/
WORKDIR /app
COPY --from=manifests /out/ /app/
# third-party deps of the server package (+ its workspace deps: twobme-common, twobme-ml, hearsay[server])
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-workspace --package twobme-server
