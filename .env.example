# 2bME environment (§5.7). Copy to .env on the VM; never commit .env.

# --- Site and security ---
DOMAIN=2bme.tech
PUBLIC_BASE_URL=https://2bme.tech
ACME_EMAIL=
SESSION_SECRET=change-me-64-random-bytes
DEMO_MODE=1
ADMIN_TOKEN=change-me
# Seed passwords for a@ / b@ / admin@2bme.tech (argon2-hashed at first start)
SEED_PASSWORD_A=
SEED_PASSWORD_B=
SEED_PASSWORD_ADMIN=
# Fernet-style key for users.totp_secret_enc (generated if empty, dev only)
TOTP_ENC_KEY=
# false from DEMO FREEZE (Sun 06:45)
CONTINUOUS_UPDATE=true
# With COOKIE_SECURE=true (production) the API refuses to start while SESSION_SECRET, ADMIN_TOKEN or any
# SEED_PASSWORD_* is empty or still a placeholder above. Local http dev: COOKIE_SECURE=false.
COOKIE_SECURE=true

# --- Identity model (§5.7) ---
# auto = twobme_ml (Codex 1) when installed, else the server's fallback model; twobme_ml | fallback pin it.
# If twobme_ml refuses a first training job (gates unmet), that job trains the fallback model and the
# identity card says so (ModelInfo.backend / metrics.backend_note).
MODEL_BACKEND=auto
# demo habit rule: the owner deletes words with ⌥⌫; every 30 s of typing without one drops trust 17 points (off unless true)
HABIT_WORD_DELETE=false
HABIT_WINDOW_S=30
HABIT_DROP=0.17

# --- Tiger Data ---
TIGER_DATABASE_URL=postgres://tsdbadmin:PASSWORD@HOST.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require

# --- Voice (server/app/voice/README.md) ---
# stub | real. stub = canned/operator-chosen results, badged "simulated" in the UI; allowed only with
# DEMO_MODE=1. real = Hearsay VAD + DF_Arena CM + ECAPA + DSP + STT; needs the `voice` extra (torch),
# pinned weights and a measured calibration JSON, else /api/healthz stays 503. Unset: stub when
# DEMO_MODE=1 and ELEVENLABS_MODE=stub, otherwise real. The VM pins stub until the real-mode smoke passes.
VOICE_MODE=stub
# measured calibration JSON bound to both model revisions (real mode refuses to start without it)
VOICE_CALIBRATION_PATH=
# CM model (DF_Arena default) + full 40-char HF commit SHAs for the CM and ECAPA weights
VOICE_CM_MODEL=Speech-Arena-2025/DF_Arena_500M_V_1
VOICE_CM_REVISION=
VOICE_ECAPA_REVISION=
# cpu | cuda
VOICE_DEVICE=cpu
# quiet | expo (which enrollment centroid a new voice enrollment writes)
VOICE_ENROLLMENT_LABEL=quiet
# preinstalled faster-whisper model directory for STT_BACKEND=local
VOICE_LOCAL_STT_PATH=
# demo USB mic label (web build: NEXT_PUBLIC_VOICE_MIC_LABEL)
VOICE_MIC_LABEL=

# --- ElevenLabs ---
# stub | live  (stub = local beep prompt + displayed phrase, forces local STT; tests/CI never call ElevenLabs)
ELEVENLABS_MODE=stub
# local | elevenlabs (Scribe only when ELEVENLABS_MODE=live)
STT_BACKEND=local
ELEVENLABS_API_KEY=
ELEVENLABS_API_KEY_BACKUP=
# premade voice, NEVER a clone
ELEVENLABS_PROMPT_VOICE_ID=
# IVC of A, used ONLY by the attack tool (hearsay redteam attack)
ELEVENLABS_REDTEAM_VOICE_A=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2

# --- Vultr Serverless Inference (A5 explanations) ---
VULTR_SERVERLESS_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_MODEL=

# --- Paths ---
MODEL_DIR=/app/data/models
DATA_DIR=/app/data
HF_HOME=/models/hf
# where contracts/ lives inside the container (auto-detected from the repo when unset)
TWOBME_CONTRACTS_DIR=/app/contracts

# --- Agent ---
TWOBME_API=https://2bme.tech
