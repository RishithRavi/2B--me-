#!/usr/bin/env bash
# Rejects pushes containing audio outside tests/fixtures/synthetic/ (§2.2 "No audio in git").
# Install once per clone:  git config core.hooksPath scripts/hooks
set -euo pipefail
zero=0000000000000000000000000000000000000000
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  bad=$(git diff --name-only --diff-filter=AM "$range" 2>/dev/null \
        | grep -Ei '\.(wav|mp3|webm|flac|m4a)$' | grep -v 'tests/fixtures/synthetic/' || true)
  if [ -n "$bad" ]; then
    echo "pre-push: audio files outside tests/fixtures/synthetic/ are not allowed:" >&2
    echo "$bad" | sed 's/^/  /' >&2
    exit 1
  fi
done
exit 0
